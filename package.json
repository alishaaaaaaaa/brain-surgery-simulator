{
  "name": "brain-surgery-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Educational browser simulator of IC-PC aneurysm clipping via a pterional transsylvian approach. Not for clinical use.",
  "scripts": {
