    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "postprocessing": "^6.39.5",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
